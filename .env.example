# --- Database (Supabase in prod, local Postgres in dev) ---
# Plain Postgres, so this is the ONLY thing that changes when you move Supabase -> RDS -> Neon.
DATABASE_URL=postgres://localhost:5432/apprank

# --- MCP server auth ---
# Clients send `Authorization: Bearer <this value>`. Generate a strong random key.
# The server REFUSES every request if this is unset (fail-closed).
MCP_API_KEY=replace-with-a-strong-random-key
# OWNER key (optional). If set, a client authenticating with THIS key unlocks the
# private owner tools (top_feedback). External clients on MCP_API_KEY can submit
# feedback but cannot read the private digest. Keep this separate from MCP_API_KEY.
MCP_ADMIN_KEY=replace-with-a-different-strong-random-key

# --- Web (apps/web) ---
# Optional port for the local MCP server CLI (`npm run start --workspace @docket/mcp`)
# PORT=3001

# --- llms.txt install URL (apps/web) ---
# Public base URL of the MCP server, advertised in /llms.txt so agents can self-install.
# MCP_URL=https://docket.vercel.app/mcp
